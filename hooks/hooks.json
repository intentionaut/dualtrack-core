{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/lock_hook.py\""}
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/source_health.py\" --background"},
          {"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/start_hint.py\""}
        ]
      }
    ]
  }
}
